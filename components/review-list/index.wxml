<view class="review-list">
  <view class="rl-title" wx:if="{{title}}">
    {{ title }}<text class="rl-count" wx:if="{{total}}">({{ total }})</text>
  </view>
  <view class="rl-empty" wx:if="{{!loading && list.length === 0}}">暂无评价</view>

  <view class="rl-item" wx:for="{{list}}" wx:key="reviewId" wx:for-item="r">
    <view class="rl-head">
      <text class="rl-name">{{ r.customerName || '匿名用户' }}</text>
      <view class="rl-stars">
        <text
          wx:for="{{stars}}"
          wx:key="*this"
          wx:for-item="n"
          class="rl-star {{n <= r.rating ? 'on' : ''}}"
        >★</text>
      </view>
    </view>
    <view class="rl-content" wx:if="{{r.content}}">{{ r.content }}</view>
    <view class="rl-imgs" wx:if="{{r.imgs.length}}">
      <image
        wx:for="{{r.imgs}}"
        wx:key="*this"
        wx:for-item="img"
        wx:for-index="idx"
        class="rl-img"
        src="{{img}}"
        mode="aspectFill"
        data-urls="{{r.imgs}}"
        data-idx="{{idx}}"
        bindtap="preview"
      />
    </view>
    <view class="rl-reply" wx:if="{{r.reply}}">回复:{{ r.reply }}</view>
  </view>
</view>
