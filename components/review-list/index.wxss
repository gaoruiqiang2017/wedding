.review-list {
  padding: 8rpx 0;
}
.rl-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.rl-count {
  color: #999;
  font-size: 24rpx;
  margin-left: 8rpx;
}
.rl-empty {
  color: #bbb;
  font-size: 26rpx;
  padding: 20rpx 0;
}
.rl-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 20rpx 0;
}
.rl-item:last-child {
  border-bottom: none;
}
.rl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rl-name {
  font-size: 28rpx;
  color: #333;
}
.rl-stars {
  display: flex;
}
.rl-star {
  font-size: 26rpx;
  color: #ddd;
}
.rl-star.on {
  color: #ffb400;
}
.rl-content {
  margin: 12rpx 0;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.rl-imgs {
  display: flex;
  flex-wrap: wrap;
}
.rl-img {
  width: 180rpx;
  height: 180rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
}
.rl-reply {
  margin-top: 10rpx;
  padding: 14rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #8a6a3e;
}
