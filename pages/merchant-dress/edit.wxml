<view class="page">
  <!-- 封面 -->
  <view class="card">
    <text class="sec-title">封面图</text>
    <view class="cover-box" bindtap="chooseCover">
      <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="aspectFill" />
      <view wx:else class="cover-ph">＋ 上传封面</view>
    </view>
  </view>

  <!-- 图册 -->
  <view class="card">
    <text class="sec-title">款式图册(最多 9 张)</text>
    <view class="album">
      <view wx:for="{{albumUrls}}" wx:key="index" class="album-item">
        <image class="album-img" src="{{item}}" mode="aspectFill" bindtap="previewAlbum" data-index="{{index}}" />
        <text class="album-del" catchtap="removeAlbum" data-index="{{index}}">×</text>
      </view>
      <view wx:if="{{album.length < 9}}" class="album-add" bindtap="addAlbum">＋</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card form">
    <view class="field">
      <text class="label req">婚纱编号</text>
      <input class="input" placeholder="如 HS-001" value="{{form.dressNo}}" data-field="dressNo" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label req">款式名称</text>
      <input class="input" placeholder="请输入款式名称" value="{{form.dressName}}" data-field="dressName" bindinput="onInput" />
    </view>
    <picker class="field" mode="selector" range="{{styleOptions}}" range-key="label" value="{{styleIndex}}" bindchange="onStyle">
      <text class="label">风格</text>
      <view class="picker-val">{{ styleIndex >= 0 ? styleOptions[styleIndex].label : '请选择' }}</view>
    </picker>
    <view class="field">
      <text class="label">颜色</text>
      <input class="input" placeholder="如 白色/香槟" value="{{form.color}}" data-field="color" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">尺码</text>
      <input class="input" placeholder="如 S/M/均码" value="{{form.dressSize}}" data-field="dressSize" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">品牌</text>
      <input class="input" placeholder="选填" value="{{form.brand}}" data-field="brand" bindinput="onInput" />
    </view>
    <picker class="field" mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatus">
      <text class="label">状态</text>
      <view class="picker-val">{{ statusOptions[statusIndex].label }}</view>
    </picker>
    <view class="field col">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="选填" value="{{form.remark}}" data-field="remark" bindinput="onInput" />
    </view>
  </view>

  <button class="btn-primary submit" loading="{{saving}}" bindtap="save">保存</button>
</view>
