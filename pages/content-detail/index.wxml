<view class="page" wx:if="{{loaded}}">
  <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="widthFix" />
  <view class="body">
    <view class="title">{{ data.title }}</view>
    <view class="meta">
      <text wx:if="{{catLabel}}">{{ catLabel }}</text>
      <text>👁 {{ data.viewCount || 0 }}</text>
    </view>
    <rich-text class="content" nodes="{{data.content || ''}}"></rich-text>
    <view wx:if="{{data.dressId}}" class="dress-link" bindtap="goDress">
      <text class="dress-link-text">查看同款婚纱</text>
      <text class="dress-link-arrow">›</text>
    </view>
  </view>
  <view class="like-bar">
    <button class="like-btn {{liked ? 'liked' : ''}}" bindtap="doLike">♥ 点赞 {{ data.likeCount || 0 }}</button>
  </view>
</view>

<view wx:else class="placeholder">加载中…</view>
