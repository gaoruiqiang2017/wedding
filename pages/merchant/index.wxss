.page {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
}
.card {
  margin-bottom: 24rpx;
}

.tip {
  padding: 20rpx 24rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #7d7177;
  line-height: 1.7;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #2b2622;
}
.menu-item:last-child {
  border-bottom: none;
}
.mi-left {
  display: flex;
  align-items: center;
}
.mi-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}
.menu-right {
  display: flex;
  align-items: center;
}
.mi-sub {
  font-size: 22rpx;
  color: #b0a8ac;
  margin-right: 8rpx;
}
.arrow {
  color: #ccc;
  font-size: 36rpx;
}
.logout-btn {
  margin-top: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #b0a8ac;
  padding: 24rpx;
}
