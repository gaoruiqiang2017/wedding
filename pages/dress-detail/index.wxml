<view class="page" wx:if="{{loaded}}">
  <!-- 主图 -->
  <view class="banner" bindtap="previewCover">
    <image class="banner-img" src="{{cover}}" mode="aspectFill" />
  </view>

  <!-- 基本信息 -->
  <view class="card sec">
    <view class="title-row">
      <text class="name">{{ dress.dressName }}</text>
      <text class="tag" style="background: {{statusColor}}">{{ statusLabel }}</text>
    </view>
    <view class="attrs">
      <view class="attr"><text class="k">编号</text><text class="v">{{ dress.dressNo || '-' }}</text></view>
      <view class="attr"><text class="k">风格</text><text class="v">{{ styleLabel || '-' }}</text></view>
      <view class="attr"><text class="k">颜色</text><text class="v">{{ dress.color || '-' }}</text></view>
      <view class="attr"><text class="k">尺码</text><text class="v">{{ dress.dressSize || '-' }}</text></view>
      <view class="attr"><text class="k">品牌</text><text class="v">{{ dress.brand || '-' }}</text></view>
    </view>
  </view>

  <!-- 全部图册 -->
  <view class="card sec" wx:if="{{album.length}}">
    <view class="sec-title">款式图册</view>
    <view class="album">
      <image
        class="album-img"
        wx:for="{{album}}"
        wx:key="*this"
        wx:for-item="img"
        wx:for-index="idx"
        src="{{img}}"
        mode="aspectFill"
        lazy-load
        data-idx="{{idx}}"
        bindtap="previewAlbum"
      />
    </view>
  </view>

  <!-- 底部悬浮咨询栏 -->
  <view class="footer">
    <button class="btn-ghost store-btn" bindtap="goStore">门店信息</button>
    <button class="btn-primary book-btn" bindtap="goContact">联系客服咨询</button>
  </view>
</view>

<view wx:else class="placeholder">加载中…</view>
