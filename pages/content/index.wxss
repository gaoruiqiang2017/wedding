.page {
  padding: 0 24rpx 60rpx;
}
.cats {
  white-space: nowrap;
  padding: 16rpx 0;
}
.cat {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 999rpx;
}
.cat.active {
  color: #fff;
  background: #c8a26d;
}
.list {
  display: flex;
  flex-direction: column;
}
.item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.cover {
  width: 220rpx;
  height: 165rpx;
  border-radius: 14rpx;
  background: #eee;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f857a;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.meta {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #8f857a;
}
.cat-tag {
  background: #f7f3ec;
  color: #b08a5a;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 20rpx;
}
.stat {
  margin-right: 20rpx;
}
