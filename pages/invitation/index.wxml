<view class="page style-{{style}}" wx:if="{{loaded && !loadError}}">
  <view class="preview-bar" wx:if="{{preview}}">
    <text class="preview-bar-text">预览中，效果与宾客所见一致</text>
    <text class="preview-bar-back" bindtap="backToEdit">返回编辑</text>
  </view>
  <view class="music-fab {{musicPlaying ? 'spin' : ''}}" wx:if="{{hasMusic}}" catchtap="toggleMusic">
    <text class="music-fab-icon">♪</text>
  </view>

  <!-- 1-3: 卡片信息流 -->
  <block wx:if="{{layout === 'card'}}">
    <view class="hero">
      <image class="hero-img" src="{{coverUrl}}" mode="aspectFill" />
      <view class="hero-mask"></view>
      <view class="hero-content">
        <text class="eyebrow">诚挚邀请</text>
        <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
        <text class="title" wx:if="{{invitation.title}}">{{ invitation.title }}</text>
      </view>
    </view>
    <view class="section card-like">
      <text class="sec-label">婚礼信息</text>
      <view class="info-row" wx:if="{{timeText}}"><text class="k">时间</text><text class="v">{{ timeText }}</text></view>
      <view class="info-row" wx:if="{{invitation.venueName}}"><text class="k">场地</text><text class="v">{{ invitation.venueName }}</text></view>
      <view class="info-row" wx:if="{{invitation.venueAddress}}"><text class="k">地址</text><text class="v">{{ invitation.venueAddress }}</text></view>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
    <view class="section card-like" wx:if="{{invitation.welcomeText}}">
      <text class="sec-label">邀请寄语</text>
      <text class="welcome">{{ invitation.welcomeText }}</text>
    </view>
    <view class="section card-like" wx:if="{{albumUrls.length}}">
      <text class="sec-label">甜蜜瞬间</text>
      <view class="album">
        <image class="album-img" wx:for="{{albumUrls}}" wx:key="*this" wx:for-item="img" wx:for-index="idx" src="{{img}}" mode="aspectFill" lazy-load data-idx="{{idx}}" bindtap="previewAlbum" />
      </view>
    </view>
  </block>

  <!-- 4 poetic 诗意长卷 -->
  <block wx:elif="{{layout === 'poetic'}}">
    <view class="poetic-head">
      <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <text class="sub">{{ timeText }}</text>
    </view>
    <image class="full-img" src="{{coverUrl}}" mode="widthFix" bindtap="previewCover" />
    <view class="poem" wx:if="{{welcomeLines.length}}">
      <text class="poem-line" wx:for="{{welcomeLines}}" wx:key="*this">{{ item }}</text>
    </view>
    <image class="full-img" wx:for="{{albumUrls}}" wx:key="*this" wx:for-item="img" wx:for-index="idx" src="{{img}}" mode="widthFix" data-idx="{{idx}}" bindtap="previewAlbum" />
    <view class="section card-like">
      <view class="info-row" wx:if="{{invitation.venueName}}"><text class="k">场地</text><text class="v">{{ invitation.venueName }}</text></view>
      <view class="info-row" wx:if="{{invitation.venueAddress}}"><text class="k">地址</text><text class="v">{{ invitation.venueAddress }}</text></view>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 5 dual 双帧 -->
  <block wx:elif="{{layout === 'dual'}}">
    <view class="dual-top">
      <image class="dual-img" src="{{coverUrl}}" mode="aspectFill" bindtap="previewCover" />
      <image class="dual-deco" src="{{albumUrls[0] || coverUrl}}" mode="widthFix" />
    </view>
    <view class="dual-bottom">
      <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <text class="poem-line" wx:for="{{welcomeLines}}" wx:key="*this">{{ item }}</text>
      <text class="sub" wx:if="{{timeText}}">{{ timeText }}</text>
      <text class="sub" wx:if="{{invitation.venueName || invitation.venueAddress}}">{{ invitation.venueName || invitation.venueAddress }}</text>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 6 calendar -->
  <block wx:elif="{{layout === 'calendar'}}">
    <view class="cal-hero">
      <image class="cal-bg" src="{{coverUrl}}" mode="aspectFill" />
      <view class="cal-panel">
        <view class="cal-head">
          <text class="cal-month">{{ cal.month }}</text>
          <text class="cal-day">/{{ cal.day }}</text>
          <text class="cal-year">- {{ cal.year }} -</text>
        </view>
        <view class="cal-week">
          <text wx:for="{{cal.weekdays}}" wx:key="*this">{{ item }}</text>
        </view>
        <view class="cal-grid">
          <view class="cal-cell {{item === cal.day ? 'on' : ''}} {{item ? '' : 'empty'}}" wx:for="{{cal.days}}" wx:key="index">
            <text wx:if="{{item}}">{{ item }}</text>
            <image wx:if="{{item === cal.day}}" class="cal-love" src="/images/invite/dateLove.svg" mode="widthFix" />
          </view>
        </view>
      </view>
    </view>
    <view class="section card-like">
      <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <text class="welcome" wx:if="{{invitation.welcomeText}}">{{ invitation.welcomeText }}</text>
      <view class="info-row" wx:if="{{invitation.venueName}}"><text class="k">场地</text><text class="v">{{ invitation.venueName }}</text></view>
      <view class="info-row" wx:if="{{invitation.venueAddress}}"><text class="k">地址</text><text class="v">{{ invitation.venueAddress }}</text></view>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 7 mapfocus -->
  <block wx:elif="{{layout === 'mapfocus'}}">
    <view class="map-head">
      <text class="map-title">恭候光临</text>
      <text class="map-en">WEDDING INVITATION</text>
      <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <text class="info-line" wx:if="{{timeText}}">日期：{{ timeText }}</text>
      <text class="info-line" wx:if="{{invitation.venueName}}">场地：{{ invitation.venueName }}</text>
      <text class="info-line" wx:if="{{invitation.venueAddress}}">位置：{{ invitation.venueAddress }}</text>
    </view>
    <map wx:if="{{hasGeo}}" class="focus-map" latitude="{{invitation.latitude}}" longitude="{{invitation.longitude}}" markers="{{markers}}" scale="15" enable-zoom enable-scroll></map>
    <image wx:else class="full-img" src="{{coverUrl}}" mode="widthFix" />
    <button class="nav-btn map-nav" wx:if="{{hasGeo}}" bindtap="openLocation">导航</button>
    <text class="welcome section-pad" wx:if="{{invitation.welcomeText}}">{{ invitation.welcomeText }}</text>
  </block>

  <!-- 8 story -->
  <block wx:elif="{{layout === 'story'}}">
    <view class="story-wrap">
      <text class="story-top">好久不见，婚礼见</text>
      <text class="story-love">Love</text>
      <text class="story-story">Story</text>
      <text class="story-en">You're invited to celebrate with us.</text>
      <text class="story-zh">诚挚邀请 · {{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <image class="story-img" src="{{coverUrl}}" mode="widthFix" bindtap="previewCover" />
      <view class="story-bottom">
        <text class="poem-line" wx:for="{{welcomeLines}}" wx:key="*this">{{ item }}</text>
        <text class="sub" wx:if="{{timeText}}">{{ timeText }}</text>
        <text class="sub" wx:if="{{invitation.venueAddress || invitation.venueName}}">{{ invitation.venueName || invitation.venueAddress }}</text>
        <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
      </view>
    </view>
  </block>

  <!-- 9 collage -->
  <block wx:elif="{{layout === 'collage'}}">
    <view class="collage">
      <text class="collage-top">with you</text>
      <image class="ornament" src="/images/invite/invite9-top.svg" mode="widthFix" />
      <image class="collage-bg" src="{{coverUrl}}" mode="widthFix" bindtap="previewCover" />
      <view class="collage-box">
        <text class="wedding-en">WEDDING</text>
        <text class="wedding-zh">婚礼</text>
        <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
        <view class="collage-imgs">
          <image class="c-img" src="{{albumUrls[0] || coverUrl}}" mode="aspectFill" data-idx="0" bindtap="previewAlbum" />
          <image class="c-img" src="{{albumUrls[1] || albumUrls[0] || coverUrl}}" mode="aspectFill" data-idx="1" bindtap="previewAlbum" />
        </view>
        <view class="collage-words">
          <text class="poem-line" wx:for="{{welcomeLines}}" wx:key="*this">{{ item }}</text>
        </view>
        <image class="ornament" src="/images/invite/invite9-bottom.svg" mode="widthFix" />
      </view>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 10 vertical -->
  <block wx:elif="{{layout === 'vertical'}}">
    <view class="vert">
      <view class="vert-side">
        <text>|</text><text>LOVE</text><text>IN</text><text>YOUR EYES</text><text>|</text>
      </view>
      <text class="vert-cap left">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <image class="vert-img" src="{{coverUrl}}" mode="widthFix" bindtap="previewCover" />
      <text class="vert-cap right">{{ timeText || 'WEDDING DAY' }}</text>
      <image class="ornament" src="/images/invite/invite10-bottom.svg" mode="widthFix" />
      <text class="welcome" wx:if="{{invitation.welcomeText}}">{{ invitation.welcomeText }}</text>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 11 rose -->
  <block wx:elif="{{layout === 'rose'}}">
    <view class="rose">
      <view class="rose-top">
        <text class="poem-line" wx:for="{{welcomeLines}}" wx:key="*this">{{ item }}</text>
      </view>
      <text class="rose-en">We got married</text>
      <view class="rose-side">
        <text>I WILL</text><text>LOVE YOU</text><text>FOREVER</text>
      </view>
      <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
      <image class="rose-img" src="{{coverUrl}}" mode="widthFix" bindtap="previewCover" />
      <text class="sub" wx:if="{{timeText}}">{{ timeText }}</text>
      <text class="sub" wx:if="{{invitation.venueName || invitation.venueAddress}}">{{ invitation.venueName || invitation.venueAddress }}</text>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 12 seastory -->
  <block wx:elif="{{layout === 'seastory'}}">
    <view class="sea">
      <image class="sea-img" src="{{coverUrl}}" mode="widthFix" bindtap="previewCover" />
      <text class="sea-en">Our love story</text>
      <view class="sea-center">
        <text class="names">{{ invitation.groomName }} & {{ invitation.brideName }}</text>
        <text class="sub" wx:if="{{timeText}}">{{ timeText }}</text>
      </view>
      <image class="sea-img" src="{{albumUrls[0] || coverUrl}}" mode="widthFix" data-idx="0" bindtap="previewAlbum" />
      <text class="welcome" wx:if="{{invitation.welcomeText}}">{{ invitation.welcomeText }}</text>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <!-- 13 beside -->
  <block wx:else>
    <view class="beside">
      <view class="beside-row">
        <view class="beside-left">
          <text class="poem-line" wx:for="{{welcomeLines}}" wx:key="*this">{{ item }}</text>
          <view class="beside-names">
            <text>{{ invitation.groomName }}</text>
            <text>&</text>
            <text>{{ invitation.brideName }}</text>
          </view>
        </view>
        <image class="beside-img" src="{{coverUrl}}" mode="aspectFill" bindtap="previewCover" />
      </view>
      <image class="ornament" src="/images/invite/invite13-bottom.svg" mode="widthFix" />
      <text class="sub" wx:if="{{timeText}}">{{ timeText }}</text>
      <text class="sub" wx:if="{{invitation.venueName || invitation.venueAddress}}">{{ invitation.venueName || invitation.venueAddress }}</text>
      <button class="nav-btn" wx:if="{{hasGeo}}" bindtap="openLocation">导航前往</button>
    </view>
  </block>

  <view class="footer-tip">花田喜事 · 门店为到店顾客制作的婚礼邀请展示</view>
</view>

<view wx:elif="{{loadError}}" class="placeholder">请柬不存在或未发布</view>
<view wx:else class="placeholder">加载中…</view>
