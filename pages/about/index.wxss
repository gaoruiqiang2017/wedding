.page {
  padding: 24rpx 24rpx 220rpx;
  min-height: 100vh;
}
/* 固定在 tab 栏上方的版本 / 备案信息(不随内容滚动) */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  padding: 12rpx 24rpx;
  background: #faf8f5;
}
.card {
  margin-bottom: 24rpx;
}

/* 登录 / 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
}
.login-row {
  display: flex;
  align-items: center;
  width: 100%;
}
.avatar-btn {
  padding: 0;
  margin: 0;
  width: 112rpx;
  height: 112rpx;
  line-height: normal;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f0e8e0;
  flex-shrink: 0;
}
.user-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2622;
}
.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2622;
  height: 44rpx;
  line-height: 44rpx;
}
.ph {
  color: #bbb;
  font-weight: 400;
}
.user-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f857a;
}
.logout {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #c8a26d;
  padding: 8rpx 16rpx;
}
.hero {
  text-align: center;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
}
.hero .title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2b2622;
}
.hero .desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #7d7177;
  line-height: 1.7;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #2b2622;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-right {
  display: flex;
  align-items: center;
}
.menu-sub {
  color: #8f857a;
  font-size: 24rpx;
  margin-right: 8rpx;
}
.arrow {
  color: #cbb79a;
  margin-left: 4rpx;
}
.ver {
  text-align: center;
  font-size: 24rpx;
  color: #8f857a;
}
.beian {
  margin-top: 6rpx;
  text-align: center;
}
.beian-link {
  display: block;
  font-size: 22rpx;
  color: #8f857a;
  line-height: 1.8;
}

/* 登录后昵称补填面板 */
.nick-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(43, 38, 34, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.nick-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.nick-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2622;
  text-align: center;
}
.nick-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8f857a;
  text-align: center;
  line-height: 1.5;
}
.nick-input {
  margin-top: 32rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f2ec;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #2b2622;
}
.nick-skip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b0885a;
  padding: 12rpx;
}
