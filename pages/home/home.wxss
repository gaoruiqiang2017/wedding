.page {
  padding-bottom: 60rpx;
}

/* 品牌头 */
.hero {
  background: linear-gradient(150deg, #d8b78f 0%, #c8a26d 55%, #b88a5a 100%);
  padding: 72rpx 40rpx 48rpx;
  color: #fff;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.hero-top {
  display: flex;
  align-items: baseline;
}
.brand {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.shop {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slogan {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 80, 40, 0.12);
}
.s-ico {
  color: #c8a26d;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2b2622;
}
.ph {
  color: #bbb;
}
.search-btn {
  flex-shrink: 0;
  color: #c8a26d;
  font-size: 28rpx;
  font-weight: 600;
  padding-left: 20rpx;
}

/* 分区容器 */
.sec {
  margin: 40rpx 24rpx 0;
}
/* 首个分区上移,与品牌头衔接更紧凑 */
.sec-lead {
  margin-top: 28rpx;
}

/* 瀑布流卡片 */
.ph-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(43, 38, 34, 0.05);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.ph-card:active,
.staff-card:active,
.store-card:active {
  transform: scale(0.98);
  opacity: 0.94;
}
.ph-cover {
  width: 100%;
  display: block;
  background: #efe7dd;
}
.ph-body {
  padding: 16rpx 20rpx 22rpx;
}
.ph-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2622;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ph-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8f857a;
}

/* 明星化妆师 横滑 */
.staff-scroll {
  white-space: nowrap;
}
.staff-card {
  display: inline-block;
  width: 220rpx;
  margin-right: 20rpx;
  vertical-align: top;
}
.staff-avatar {
  width: 220rpx;
  height: 260rpx;
  border-radius: 20rpx;
  background: #efe7dd;
}
.staff-name {
  display: block;
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #2b2622;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.staff-level {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8f857a;
}

/* 门店一览 */
.store-card {
  padding: 32rpx;
}
.store-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.store-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b2622;
}
.store-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #b0885a;
}
.store-more-arr {
  margin-left: 8rpx;
  color: #cbb79a;
}
.store-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.store-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #6f655b;
  line-height: 1.5;
}

.beian {
  padding: 44rpx 24rpx 24rpx;
  text-align: center;
}
.beian-link {
  display: block;
  font-size: 22rpx;
  color: #a4998d;
  line-height: 1.8;
}
