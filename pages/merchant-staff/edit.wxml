<view class="page">
  <!-- 头像 -->
  <view class="card avatar-card">
    <text class="sec-title">头像</text>
    <view class="avatar-box" bindtap="chooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar ph">＋</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card form">
    <view class="field">
      <text class="label req">姓名</text>
      <input class="input" placeholder="请输入姓名" value="{{form.staffName}}" data-field="staffName" bindinput="onInput" />
    </view>
    <picker class="field" mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onType">
      <text class="label">类型</text>
      <view class="picker-val">{{ typeOptions[typeIndex].label }}</view>
    </picker>
    <picker class="field" mode="selector" range="{{levelOptions}}" range-key="label" value="{{levelIndex}}" bindchange="onLevel">
      <text class="label">级别</text>
      <view class="picker-val">{{ levelOptions[levelIndex].label }}</view>
    </picker>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="选填" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">从业年限</text>
      <input class="input" type="number" placeholder="选填" value="{{form.yearsExp}}" data-field="yearsExp" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">标签</text>
      <input class="input" placeholder="逗号分隔,如 新娘妆,日系" value="{{form.tags}}" data-field="tags" bindinput="onInput" />
    </view>
    <picker class="field" mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatus">
      <text class="label">状态</text>
      <view class="picker-val">{{ statusOptions[statusIndex].label }}</view>
    </picker>
    <view class="field col">
      <text class="label">简介</text>
      <textarea class="textarea" placeholder="面向顾客展示的简介(选填)" value="{{form.intro}}" data-field="intro" bindinput="onInput" />
    </view>
  </view>

  <!-- 作品集 -->
  <view class="card">
    <text class="sec-title">作品集(最多 9 张)</text>
    <view class="album">
      <view wx:for="{{portfolioUrls}}" wx:key="index" class="album-item">
        <image class="album-img" src="{{item}}" mode="aspectFill" bindtap="previewPortfolio" data-index="{{index}}" />
        <text class="album-del" catchtap="removePortfolio" data-index="{{index}}">×</text>
      </view>
      <view wx:if="{{portfolio.length < 9}}" class="album-add" bindtap="addPortfolio">＋</view>
    </view>
  </view>

  <button class="btn-primary submit" loading="{{saving}}" bindtap="save">保存</button>
</view>
