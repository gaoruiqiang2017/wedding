.page {
  padding: 24rpx 24rpx 120rpx;
  min-height: 100vh;
}
.sec-title {
  display: block;
  font-size: 26rpx;
  color: #7d7177;
  margin-bottom: 16rpx;
}
.avatar-box {
  width: 160rpx;
  height: 160rpx;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0e8e0;
}
.avatar.ph {
  background: #f7f2ec;
  color: #b79b7d;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #d9c3a8;
}
.field {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.field:last-child {
  border-bottom: none;
}
.field.col {
  flex-direction: column;
  align-items: flex-start;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #2b2622;
  flex-shrink: 0;
}
.label.req::after {
  content: ' *';
  color: #f5222d;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.picker-val {
  flex: 1;
  font-size: 28rpx;
  color: #2b2622;
}
.textarea {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}
.album {
  display: flex;
  flex-wrap: wrap;
}
.album-item,
.album-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
  position: relative;
}
.album-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f0e8e0;
}
.album-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
}
.album-add {
  background: #f7f2ec;
  color: #b79b7d;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #d9c3a8;
}
.submit {
  margin-top: 40rpx;
}
