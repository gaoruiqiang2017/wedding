.page {
  padding: 24rpx 24rpx 60rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.s-card {
  width: 48.5%;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(43, 38, 34, 0.05);
  transition: transform 0.12s ease;
}
.s-card:active {
  transform: scale(0.98);
  opacity: 0.94;
}
.s-cover {
  width: 100%;
  height: 340rpx;
  background: #efe7dd;
}
.s-body {
  padding: 18rpx 20rpx 22rpx;
}
.s-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2622;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.s-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8f857a;
}
.s-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.s-tag {
  background: #f6efe4;
  color: #b0885a;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 8rpx 0;
}
