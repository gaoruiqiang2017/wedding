.page { padding: 24rpx 24rpx 120rpx; min-height: 100vh; }
.sec-title { display: block; font-size: 26rpx; color: #7d7177; margin-bottom: 16rpx; }
.cover-box { width: 240rpx; height: 320rpx; }
.cover { width: 240rpx; height: 320rpx; border-radius: 12rpx; background: #f0e8e0; }
.cover-ph {
  width: 240rpx; height: 320rpx; border-radius: 12rpx; background: #f7f2ec; color: #b79b7d;
  font-size: 26rpx; display: flex; align-items: center; justify-content: center; border: 1rpx dashed #d9c3a8;
}
.album { display: flex; flex-wrap: wrap; }
.album-item, .album-add {
  width: 150rpx; height: 150rpx; border-radius: 12rpx; margin: 0 16rpx 16rpx 0; position: relative;
}
.album-img { width: 150rpx; height: 150rpx; border-radius: 12rpx; background: #f0e8e0; }
.album-del {
  position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; line-height: 40rpx;
  text-align: center; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 30rpx;
}
.album-add {
  background: #f7f2ec; color: #b79b7d; font-size: 48rpx; display: flex; align-items: center;
  justify-content: center; border: 1rpx dashed #d9c3a8;
}
.field {
  display: flex; flex-direction: row; align-items: center; box-sizing: border-box; width: 100%;
  padding: 26rpx 0; border-bottom: 1rpx solid #f2f2f2;
}
.field.col { flex-direction: column; align-items: flex-start; }
.field:last-child { border-bottom: none; }
.label { width: 160rpx; font-size: 28rpx; color: #2b2622; flex-shrink: 0; white-space: nowrap; }
.label.req::after { content: ' *'; color: #f5222d; }
.input { flex: 1; width: 100%; font-size: 28rpx; }
.picker-val { flex: 1; font-size: 28rpx; color: #2b2622; }
.textarea { width: 100%; height: 160rpx; margin-top: 16rpx; font-size: 28rpx; }
.coord-tip { margin-top: 12rpx; font-size: 22rpx; color: #8f857a; }
.style-grid {
  width: 100%; margin-top: 16rpx; display: flex; flex-wrap: wrap; justify-content: space-between;
}
.style-card {
  width: calc((100% - 16rpx) / 2); box-sizing: border-box; margin-bottom: 16rpx;
  padding: 20rpx 18rpx; border-radius: 16rpx; background: #f7f2ec; border: 2rpx solid transparent;
}
.style-card.on { border-color: #c8a26d; background: #fff8ef; }
.style-name { display: block; font-size: 28rpx; color: #2b2622; font-weight: 600; }
.style-desc { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8f857a; line-height: 1.4; }
.submit { margin-top: 40rpx; }
.preview { margin-top: 20rpx; }
