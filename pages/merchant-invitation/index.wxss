.page { padding: 24rpx 24rpx 120rpx; min-height: 100vh; }
.toolbar { margin-bottom: 24rpx; }
.add-btn { height: 84rpx; line-height: 84rpx; border-radius: 999rpx; font-size: 30rpx; }
.item { padding: 20rpx; margin-bottom: 20rpx; }
.cover { width: 100%; height: 280rpx; border-radius: 16rpx; background: #f0e8e0; }
.main { padding: 20rpx 0 8rpx; }
.title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.title { flex: 1; font-size: 32rpx; font-weight: 600; color: #2b2622; }
.status { flex-shrink: 0; font-size: 22rpx; color: #8f857a; background: #f1ebe2; padding: 4rpx 14rpx; border-radius: 999rpx; }
.status.on { color: #fff; background: #c8a26d; }
.meta { display: block; margin-top: 10rpx; font-size: 24rpx; color: #8f857a; }
.actions { display: flex; gap: 28rpx; padding-top: 16rpx; border-top: 1rpx solid #efe7de; }
.act { font-size: 26rpx; color: #b0885a; }
.act.danger { color: #c45c5c; }

.share-btn { background: transparent; padding: 0; margin: 0; line-height: 1.4; font-size: 26rpx; color: #b0885a; }
.share-btn::after { border: none; }
