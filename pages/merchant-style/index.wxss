.page {
  padding: 24rpx 24rpx 120rpx;
  min-height: 100vh;
}
.tip {
  padding: 24rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #7d7177;
  line-height: 1.6;
}
.add-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}
.add-input {
  flex: 1;
  font-size: 28rpx;
  padding: 12rpx 0;
}
.add-btn {
  margin: 0 0 0 20rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #fff;
  background: #b79b7d;
  border-radius: 999rpx;
}
.add-btn::after {
  border: none;
}
.style-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.style-item:last-child {
  border-bottom: none;
}
.style-name {
  font-size: 30rpx;
  color: #2b2622;
}
.style-ops {
  display: flex;
  align-items: center;
}
.style-op {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}
.style-op.edit {
  color: #b79b7d;
}
.style-op.del {
  color: #f5222d;
}
.empty {
  text-align: center;
  color: #b0a6a0;
  font-size: 26rpx;
  padding: 80rpx 0;
}
