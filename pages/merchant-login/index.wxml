<view class="page">
  <view class="head">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />
    <text class="title">内容管理登录</text>
    <text class="sub">使用管理手机号与密码登录,登录后可维护婚纱照片与化妆师信息</text>
  </view>

  <view class="card form">
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onPassword" />
    </view>
  </view>

  <button class="btn-primary submit" loading="{{submitting}}" bindtap="submit">登录</button>
  <text class="tip">普通顾客无需登录即可浏览。如需咨询,请在「联系咨询」页联系客服。</text>
</view>
