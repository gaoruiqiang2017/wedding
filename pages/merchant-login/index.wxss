.page {
  padding: 48rpx 40rpx;
  min-height: 100vh;
}
.head {
  text-align: center;
  margin-bottom: 40rpx;
}
.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
}
.title {
  display: block;
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #2b2622;
}
.sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9a9a9a;
  line-height: 1.6;
}
.form {
  padding: 8rpx 24rpx;
}
.field {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field:last-child {
  border-bottom: none;
}
.label {
  width: 140rpx;
  font-size: 28rpx;
  color: #2b2622;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.submit {
  margin-top: 48rpx;
}
.tip {
  display: block;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #b0a8ac;
  line-height: 1.7;
  text-align: center;
}
