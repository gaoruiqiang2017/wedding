.page {
  padding: 24rpx 24rpx 60rpx;
}
.store {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.store-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.info-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #6f655b;
  line-height: 1.5;
}
.copy {
  color: #b0885a;
  font-size: 24rpx;
  margin-left: 12rpx;
}
.map-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}
.map {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}
.nav-btn {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
}
.no-geo {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.no-geo-text {
  font-size: 26rpx;
  color: #8f857a;
  text-align: center;
  margin-bottom: 20rpx;
}
.no-geo .btn-ghost {
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
}
.sec {
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.svc {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f0ea;
}
.svc:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.svc-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2622;
}
.svc-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #7a7168;
  line-height: 1.6;
}
.qr-block {
  margin-bottom: 12rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f3f3f3;
}
.contact-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}
.contact-item:last-child {
  border-bottom: none;
}
.contact-main {
  flex: 1;
  margin-left: 20rpx;
}
.contact-label {
  display: block;
  font-size: 24rpx;
  color: #8f857a;
}
.contact-val {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #333;
}
.contact-action {
  color: #c8a26d;
  font-size: 28rpx;
}
